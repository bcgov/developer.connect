# Common env across all business-ui apps
# Vaults Web Urls
NUXT_PUBLIC_REGISTRY_HOME_URL="op://web-url/$APP_ENV/registry/REGISTRY_HOME_URL"
NUXT_PUBLIC_AUTH_WEB_URL="op://web-url/$APP_ENV/auth-web/AUTH_WEB_URL"
NUXT_PUBLIC_SITEMINDER_LOGOUT_URL="op://web-url/$APP_ENV/siteminder/SITEMINDER_LOGOUT_URL"
NUXT_PUBLIC_PRE_EXISTING_COMPANY_PROVISIONS="op://web-url/$APP_ENV/bcregistry/PREEXISTING_COMPANY_PROVISIONS_URL"

# Vaults X-Apikey
NUXT_PUBLIC_X_API_KEY="op://API/$APP_ENV/business-api/BUSINESS_API_KEY"

# Vaults API Urls
# Auth API
NUXT_PUBLIC_AUTH_API_URL="op://API/$APP_ENV/auth-api/AUTH_API_GW_URL"
NUXT_PUBLIC_AUTH_API_VERSION="op://API/$APP_ENV/auth-api/AUTH_API_VERSION"

# Status API
NUXT_PUBLIC_STATUS_API_URL="op://API/$APP_ENV/status-api/STATUS_API_URL"
NUXT_PUBLIC_STATUS_API_VERSION="op://API/$APP_ENV/status-api/STATUS_API_VERSION"

# Vaults Identity Provider
NUXT_PUBLIC_IDP_URL="op://keycloak/$APP_ENV/base/KEYCLOAK_AUTH_BASE_URL"
NUXT_PUBLIC_IDP_REALM="op://keycloak/$APP_ENV/base/KEYCLOAK_REALMNAME"

NUXT_PUBLIC_BASE_URL="op://web-url/$APP_ENV/api-document/API_WEB_URL"
NUXT_PUBLIC_IDP_CLIENTID="op://keycloak/$APP_ENV/entity-web/UI_KEYCLOAK_RESOURCE_NAME"
NUXT_PUBLIC_LD_CLIENT_ID="op://launchdarkly/$APP_ENV/entity-ui/LD_CLIENT_ID"
